# Django
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DJANGO_DEBUG=True

# Database (PostgreSQL)
DB_NAME=school_exam_db
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (Celery broker + Django cache / channel layer)
# In Docker these are overridden to redis://redis:6379/... automatically.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
EDUNEXUS_REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Public URL used in email links (set to your tunnel/server URL)
SITE_URL=http://localhost:8000

# Security (optional)
FIELD_ENCRYPTION_KEY=leave-empty-to-use-secret-key
DATA_INTEGRITY_KEY=leave-empty-to-use-secret-key

# ── Deployment (cloud / Docker) ────────────────────────────────────────────
# Compose sets the safe production values automatically; these exist for
# bare-metal deployments and for tuning. All flags accept true/false.
#
# ALLOWED_HOSTS=*                # comma list, or * while the tunnel URL is random
# CSRF_TRUSTED_ORIGINS=https://my-app.trycloudflare.com
# EDUNEXUS_SECURE_PROXY=True     # trust X-Forwarded-Proto (keep True behind a tunnel)
# SECURE_SSL_REDIRECT=True       # force HTTPS (keep True behind a tunnel)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# EDUNEXUS_HSTS=True             # 1-year HSTS once you are sure about HTTPS
# EDUNEXUS_SERVE_MEDIA=True      # let Django serve /media/ uploads (single-server mode)
# EDUNEXUS_INTERNAL_URL=         # e.g. http://web:8080 so Celery PDFs can fetch media
# EDUNEXUS_PDF_ENGINE=auto       # auto | playwright | weasyprint (weasyprint saves RAM)
